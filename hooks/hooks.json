{
  "description": "知识库项目识别：使用 Claude Code 指令来源，在提交提示词时提醒加载项目规范。",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -Command \"& (Join-Path ([Environment]::GetEnvironmentVariable('CLAUDE_PLUGIN_ROOT')) 'hooks/kb-project-detect.ps1') -Platform claude\"",
            "timeout": 10,
            "statusMessage": "识别知识库项目..."
          }
        ]
      }
    ]
  }
}
